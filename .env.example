# === OmniClaims Adjuster — Environment Variables ===
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# === Authentication Mode ===
# Option 1: Vertex AI (recommended — uses Google Cloud $300 free credits)
USE_VERTEX_AI=true
GOOGLE_CLOUD_PROJECT=your-project-id-here
GOOGLE_CLOUD_LOCATION=global

# Option 2: API Key (Google AI Studio)
# USE_VERTEX_AI=false
# GEMINI_API_KEY=your-api-key-here

# === Model Configuration ===
# Gemini 3.1 Pro for deep reasoning (requires location=global)
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
# Gemini 3 Flash for fast UI interactions
GEMINI_FLASH_MODEL=gemini-3-flash-preview

# === Server ===
HOST=0.0.0.0
PORT=7860
DEBUG=true
LOG_LEVEL=INFO
